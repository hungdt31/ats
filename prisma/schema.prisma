generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                                        String                       @id @default(dbgenerated("(uuid())")) @db.Char(36)
  email                                     String                       @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash                              String?                      @map("password_hash") @db.VarChar(255)
  fullName                                  String                       @map("full_name") @db.VarChar(255)
  phone                                     String?                      @db.VarChar(20)
  role                                      UserRole                     @default(candidate)
  avatarUrl                                 String?                      @map("avatar_url") @db.Text
  provider                                  String?                      @db.VarChar(50)
  isActive                                  Boolean                      @default(true) @map("is_active")
  emailVerified                             Boolean                      @default(false) @map("email_verified")
  lastLoginAt                               DateTime?                    @map("last_login_at") @db.DateTime(0)
  createdAt                                 DateTime                     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                 DateTime                     @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  application_status_history                application_status_history[]
  applications                              applications[]
  candidate_profiles                        candidate_profiles?
  email_logs_email_logs_recipient_idTousers email_logs[]                 @relation("email_logs_recipient_idTousers")
  email_logs_email_logs_sender_idTousers    email_logs[]                 @relation("email_logs_sender_idTousers")
  interview_scores                          interview_scores[]
  interviews                                interviews[]
  jobs                                      jobs[]
  files                                     files[]

  @@index([isActive], map: "idx_users_is_active")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model application_status_history {
  id             String       @id @default(dbgenerated("(uuid())")) @db.Char(36)
  application_id String       @db.Char(36)
  changed_by     String       @db.Char(36)
  from_status    String?      @db.VarChar(50)
  to_status      String       @db.VarChar(50)
  note           String?      @db.Text
  changed_at     DateTime     @default(now()) @db.DateTime(0)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "fk_ash_application")
  users          User         @relation(fields: [changed_by], references: [id], map: "fk_ash_changed_by")

  @@index([changed_by], map: "fk_ash_changed_by")
  @@index([application_id], map: "idx_ash_application_id")
  @@index([changed_at], map: "idx_ash_changed_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model applications {
  id                         String                       @id @default(dbgenerated("(uuid())")) @db.Char(36)
  job_id                     String                       @db.Char(36)
  candidate_id               String                       @db.Char(36)
  cv_file_url                String                       @db.Text
  cv_filename                String?                      @db.VarChar(255)
  cover_letter               String?                      @db.Text
  status                     applications_status          @default(applied)
  source_channel             applications_source_channel?
  applied_at                 DateTime                     @default(now()) @db.DateTime(0)
  updated_at                 DateTime                     @default(now()) @db.DateTime(0)
  application_status_history application_status_history[]
  users                      User                         @relation(fields: [candidate_id], references: [id], map: "fk_app_candidate")
  jobs                       jobs                         @relation(fields: [job_id], references: [id], map: "fk_app_job")
  email_logs                 email_logs[]
  interviews                 interviews[]

  @@unique([job_id, candidate_id], map: "uq_application")
  @@index([candidate_id], map: "idx_applications_candidate_id")
  @@index([status], map: "idx_applications_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model candidate_profiles {
  id               String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id          String   @unique(map: "uq_candidate_profiles_user_id") @db.Char(36)
  title            String?  @db.VarChar(255)
  bio              String?  @db.Text
  location         String?  @db.VarChar(255)
  years_experience Int      @default(0) @db.SmallInt
  skills           Json?
  education        Json?
  linkedin_url     String?  @db.VarChar(500)
  github_url       String?  @db.VarChar(500)
  created_at       DateTime @default(now()) @db.DateTime(0)
  updated_at       DateTime @default(now()) @db.DateTime(0)
  users            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_cp_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model email_logs {
  id                                   String            @id @default(dbgenerated("(uuid())")) @db.Char(36)
  application_id                       String            @db.Char(36)
  recipient_id                         String            @db.Char(36)
  sender_id                            String?           @db.Char(36)
  subject                              String            @db.VarChar(500)
  type                                 email_logs_type
  status                               email_logs_status @default(pending)
  sent_at                              DateTime?         @db.DateTime(0)
  error_message                        String?           @db.Text
  created_at                           DateTime          @default(now()) @db.DateTime(0)
  applications                         applications      @relation(fields: [application_id], references: [id], map: "fk_el_application")
  users_email_logs_recipient_idTousers User              @relation("email_logs_recipient_idTousers", fields: [recipient_id], references: [id], map: "fk_el_recipient")
  users_email_logs_sender_idTousers    User?             @relation("email_logs_sender_idTousers", fields: [sender_id], references: [id], map: "fk_el_sender")

  @@index([sender_id], map: "fk_el_sender")
  @@index([application_id], map: "idx_el_application_id")
  @@index([recipient_id], map: "idx_el_recipient_id")
  @@index([status], map: "idx_el_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model interview_scores {
  id                  String                  @id @default(dbgenerated("(uuid())")) @db.Char(36)
  interview_id        String                  @db.Char(36)
  evaluator_id        String                  @db.Char(36)
  technical_score     Int?                    @db.TinyInt
  communication_score Int?                    @db.TinyInt
  cultural_fit_score  Int?                    @db.TinyInt
  overall_score       Int?                    @db.TinyInt
  strengths           String?                 @db.Text
  weaknesses          String?                 @db.Text
  feedback            String?                 @db.Text
  result              interview_scores_result
  is_final            Boolean                 @default(false)
  created_at          DateTime                @default(now()) @db.DateTime(0)
  users               User                    @relation(fields: [evaluator_id], references: [id], map: "fk_is_evaluator")
  interviews          interviews              @relation(fields: [interview_id], references: [id], map: "fk_is_interview")

  @@unique([interview_id, evaluator_id], map: "uq_interview_score")
  @@index([evaluator_id], map: "idx_is_evaluator_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model interviews {
  id               String             @id @default(dbgenerated("(uuid())")) @db.Char(36)
  application_id   String             @db.Char(36)
  interviewer_id   String             @db.Char(36)
  scheduled_at     DateTime           @db.DateTime(0)
  duration_minutes Int                @default(60) @db.SmallInt
  type             interviews_type    @default(video)
  status           interviews_status  @default(scheduled)
  meeting_link     String?            @db.Text
  location         String?            @db.VarChar(255)
  notes            String?            @db.Text
  created_at       DateTime           @default(now()) @db.DateTime(0)
  interview_scores interview_scores[]
  applications     applications       @relation(fields: [application_id], references: [id], map: "fk_iv_application")
  users            User               @relation(fields: [interviewer_id], references: [id], map: "fk_iv_interviewer")

  @@index([application_id], map: "idx_interviews_application_id")
  @@index([interviewer_id], map: "idx_interviews_interviewer_id")
  @@index([scheduled_at], map: "idx_interviews_scheduled_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model job_channels {
  id            String               @id @default(dbgenerated("(uuid())")) @db.Char(36)
  job_id        String               @db.Char(36)
  channel       job_channels_channel
  external_url  String?              @db.Text
  external_id   String?              @db.VarChar(255)
  status        job_channels_status  @default(pending)
  posted_at     DateTime?            @db.DateTime(0)
  expires_at    DateTime?            @db.DateTime(0)
  error_message String?              @db.Text
  created_at    DateTime             @default(now()) @db.DateTime(0)
  jobs          jobs                 @relation(fields: [job_id], references: [id], onDelete: Cascade, map: "fk_jc_job")

  @@unique([job_id, channel], map: "uq_job_channel")
  @@index([status], map: "idx_job_channels_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model jobs {
  id              String               @id @default(dbgenerated("(uuid())")) @db.Char(36)
  created_by      String               @db.Char(36)
  title           String               @unique(map: "uq_jobs_title") @db.VarChar(255)
  /// Slug URL-friendly, dùng trên public URL thay cho id (tránh lộ UUID).
  slug            String               @unique(map: "uq_jobs_slug") @db.VarChar(300)
  description     String               @db.Text
  requirements    String?              @db.Text
  benefits        String?              @db.Text
  location        String?              @db.VarChar(255)
  department      String?              @db.VarChar(100)
  category        String?              @db.VarChar(100)
  salary_min      Int?
  salary_max      Int?
  employment_type jobs_employment_type @default(full_time)
  required_skills Json?
  headcount       Int                  @default(1) @db.SmallInt
  status          jobs_status          @default(draft)
  expires_at      DateTime?            @db.Date
  published_at    DateTime?            @db.DateTime(0)
  created_at      DateTime             @default(now()) @db.DateTime(0)
  updated_at      DateTime             @default(now()) @db.DateTime(0)
  applications    applications[]
  job_channels    job_channels[]
  users           User                 @relation(fields: [created_by], references: [id], map: "fk_jobs_created_by")

  @@index([created_by], map: "idx_jobs_created_by")
  @@index([expires_at], map: "idx_jobs_expires_at")
  @@index([slug], map: "idx_jobs_slug")
  @@index([status], map: "idx_jobs_status")
}

enum UserRole {
  candidate
  admin
  hr
  interviewer
}

model OtpToken {
  id        String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  email     String    @db.VarChar(255)
  code      String    @db.Char(60)
  type      OtpType
  attempts  Int       @default(0) @db.TinyInt
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([email, type], map: "idx_otp_email_type")
  @@map("otp_tokens")
}

enum OtpType {
  email_verify
  password_reset
}

enum job_channels_channel {
  linkedin
  itviec
  topcv
  vietnamworks
  website
}

enum email_logs_type {
  invite
  result
  reminder
  rejection
  offer
}

enum interviews_type {
  phone
  video
  onsite
  technical
}

enum job_channels_status {
  pending
  posted
  failed
  expired
  removed
}

enum applications_status {
  applied
  screening
  interviewing
  offered
  hired
  rejected
}

enum email_logs_status {
  pending
  sent
  failed
}

enum interviews_status {
  scheduled
  completed
  cancelled
  rescheduled
}

enum applications_source_channel {
  linkedin
  itviec
  topcv
  vietnamworks
  website
}

enum interview_scores_result {
  pass
  fail
  hold
}

enum jobs_employment_type {
  full_time
  part_time
  contract
}

enum jobs_status {
  draft
  active
  closed
  archived
}

model files {
  id           String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id      String   @db.Char(36)
  file_name    String   @db.VarChar(255)
  file_url     String   @db.Text
  file_type    String?  @db.VarChar(50) // 'cv', 'portfolio', 'certificate'
  appwrite_id  String?  @db.VarChar(255)
  created_at   DateTime @default(now()) @db.DateTime(0)
  updated_at   DateTime @default(now()) @db.DateTime(0)
  users        User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_files_user")

  @@index([user_id], map: "idx_files_user_id")
  @@map("files")
}

