# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# ---------------------------------------------------------------------------
# LaTeX / Beamer — artefact build trong report/ \& slide/ (không commit)
# Giữ: *.tex, source/, image/, references.bib (nếu có), latexmkrc
# ---------------------------------------------------------------------------
# Báo cáo (report/)
/report/*.aux
/report/*.log
/report/*.out
/report/*.toc
/report/*.lof
/report/*.lot
/report/*.fls
/report/*.fdb_latexmk
/report/*.synctex.gz
/report/*.bbl
/report/*.blg
/report/*.bcf
/report/*.run.xml
/report/*.pdf
/report/*.xdv
# Slide (slide/) — thêm nav/snm (Beamer)
/slide/*.aux
/slide/*.log
/slide/*.out
/slide/*.toc
/slide/*.lof
/slide/*.lot
/slide/*.fls
/slide/*.fdb_latexmk
/slide/*.synctex.gz
/slide/*.nav
/slide/*.snm
/slide/*.vrb
/slide/*.bbl
/slide/*.blg
/slide/*.pdf
/slide/*.xdv

